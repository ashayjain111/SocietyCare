{
  "name": "societycare-backend",
  "version": "1.0.0",
  "description": "SocietyCare - AI-Powered Smart Society Management System Backend",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "npx sequelize-cli db:migrate",
