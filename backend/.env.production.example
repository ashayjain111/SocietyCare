# ── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── Database (Supabase) ───────────────────────────────────
# Paste the "Connection string (URI)" from Supabase → Settings → Database
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ── JWT ──────────────────────────────────────────────────
# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_64_CHAR_SECRET
JWT_EXPIRES_IN=7d

# ── Frontend URL (your Vercel domain) ────────────────────
# Comma-separate if you have multiple (e.g. preview + production)
FRONTEND_URL=https://your-app.vercel.app

# ── Email (Gmail SMTP) ───────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password   # 16-char App Password from Google Account → Security
EMAIL_FROM=SocietyCare <your-gmail@gmail.com>

# ── Razorpay (for online payments) ───────────────────────
RAZORPAY_KEY_ID=rzp_live_XXXX
RAZORPAY_KEY_SECRET=XXXX

# ── OpenAI (for AI features — optional) ──────────────────
AI_API_KEY=sk-...

# ── Firebase (for push notifications — optional) ─────────
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
